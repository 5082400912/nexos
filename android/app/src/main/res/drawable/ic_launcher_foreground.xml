<?xml version="1.0" encoding="utf-8"?>
<!-- Ubuntu-style logo: white ring + three orange dots -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer white ring (stroke only) -->
    <path
        android:pathData="M26,54 A28,28 0 1,0 82,54 A28,28 0 1,0 26,54"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5" />

    <!-- Gap covers (aubergine fill over ring where dots sit) -->
    <!-- Top gap -->
    <path
        android:pathData="M44,26 A10,10 0 1,0 64,26 A10,10 0 1,0 44,26"
        android:fillColor="#2C001E" />
    <!-- Bottom-right gap -->
    <path
        android:pathData="M68.25,68 A10,10 0 1,0 88.25,68 A10,10 0 1,0 68.25,68"
        android:fillColor="#2C001E" />
    <!-- Bottom-left gap -->
    <path
        android:pathData="M19.75,68 A10,10 0 1,0 39.75,68 A10,10 0 1,0 19.75,68"
        android:fillColor="#2C001E" />

    <!-- Orange dots (Ubuntu orange #E95420) -->
    <!-- Top dot at (54, 26) -->
    <path
        android:pathData="M46,26 A8,8 0 1,0 62,26 A8,8 0 1,0 46,26"
        android:fillColor="#E95420" />
    <!-- Bottom-right dot at (78.25, 68) -->
    <path
        android:pathData="M70.25,68 A8,8 0 1,0 86.25,68 A8,8 0 1,0 70.25,68"
        android:fillColor="#E95420" />
    <!-- Bottom-left dot at (29.75, 68) -->
    <path
        android:pathData="M21.75,68 A8,8 0 1,0 37.75,68 A8,8 0 1,0 21.75,68"
        android:fillColor="#E95420" />

</vector>
